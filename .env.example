# ─── Bot Configuration ───
BOT_TOKEN=your_discord_bot_token_here
BOT_PREFIX=!

# ─── Guild Configuration ───
GUILD_ID=your_discord_guild_id_here

# ─── ERLC API ───
ERLC_API_KEY=your_erlc_api_key_here
ERLC_SERVER_ID=your_erlc_server_id_here

# ─── Roblox API ───
ROBLOX_API_KEY=your_roblox_api_key_here

# ─── Roblox OAuth 2.0 ───
ROBLOX_CLIENT_ID=your_roblox_oauth_client_id
ROBLOX_CLIENT_SECRET=your_roblox_oauth_client_secret
ROBLOX_REDIRECT_URI=http://localhost:8080/roblox/callback
ROBLOX_OAUTH_PORT=8080

# ─── Logging Channel ───
INFRACTION_LOG_CHANNEL_ID=your_infraction_log_channel_id_here
